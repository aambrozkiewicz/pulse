generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 sessions AuthSession[]
}
model AuthSession {
 tokenHash String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expiresAt DateTime
 @@index([expiresAt])
}
model RateLimit {
 key String @id
 count Int @default(1)
 expiresAt DateTime
}
model Site {
 id String @id @default(cuid())
 key String @unique
 name String
 origins String[]
 conversionEvent String @default("conversion")
 funnelSteps String[] @default(["page_view"])
 events Event[]
}
model Event {
 id String @id
 siteId String
 site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
 visitorId String
 sessionId String
 name String
 path String
 referrer String?
 utmSource String?
 utmMedium String?
 utmCampaign String?
 properties Json?
 createdAt DateTime @default(now())
 @@index([siteId, createdAt])
 @@index([siteId, name, createdAt])
 @@index([siteId, sessionId, createdAt])
}
